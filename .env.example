# انسخ هذا الملف إلى .env.local واملأ القيم.

# عنوان الموقع الكامل (للروابط ومحركات البحث)
SITE_URL=http://localhost:3000

# كلمة سر لوحة التحكم /admin (12 حرفاً على الأقل، ويفضّل 20 عشوائية)
ADMIN_PASSWORD=

# مفتاح عشوائي طويل لتوقيع جلسة الأدمن (32 حرفاً على الأقل)
# مثلاً: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# قاعدة البيانات: اتركها فارغة محلياً لتُستخدم قاعدة مدمجة في مجلد .data
# على الاستضافة ضع رابط PostgreSQL (مثلاً من Neon):
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# تخزين الملفات: اتركها فارغة محلياً لتُحفظ الكتب في مجلد storage
# على الاستضافة استخدم Cloudflare R2 (أو أي تخزين متوافق مع S3):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=arnooba
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://files.example.com
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=

# Google Search Console: الكود من طريقة «HTML tag» (فقط القيمة داخل content="...")
GOOGLE_SITE_VERIFICATION=

# الأمان (اختياري)
# اسمح بلوحة التحكم من عناوين IP محددة فقط، مثل: 203.0.113.7, 198.51.100.0/24
ADMIN_ALLOWED_IPS=
# إذا استضفت الموقع بنفسك خلف nginx أو غيره يضبط X-Real-IP، ضع 1 (على Vercel لا تحتاجه)
TRUST_PROXY=
